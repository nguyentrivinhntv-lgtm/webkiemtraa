# Port chạy server (Mặc định 3001)
PORT=3001

# Chuỗi kết nối MongoDB Atlas (Miễn phí 512MB vĩnh viễn)
# Lấy từ: https://cloud.mongodb.com -> Connect -> Drivers
# Ví dụ:
# MONGODB_URI=mongodb+srv://admin:matkhau123@cluster0.abcde.mongodb.net/webkiemtra?retryWrites=true&w=majority

MONGODB_URI=

